# ==============================================================================
# CIVORA CORE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="CIVORA Core Backend"
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (Defaults to async SQLite for local development)
DATABASE_URL="sqlite+aiosqlite:///./civora_dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://civora_user:civora_secret@localhost:5432/civora_db"

# Redis Queue Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=false

# Security & Tokens
SECRET_KEY="change-this-in-production-to-a-secure-32-byte-hex-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY_HEADER_NAME="X-CIVORA-KEY"

# Model Context Protocol (MCP) Streamable HTTP Configuration
MCP_SERVER_NAME="civora-engineer"
MCP_SERVER_VERSION="0.1.0"
MCP_ENDPOINT="/mcp"
MCP_AUTH_TOKEN="civora-mcp-local-dev-token"

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sandbox Execution Security
SANDBOX_BACKEND="simulation" # 'simulation' | 'docker' | 'gvisor'
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_CPUS=2.0
SANDBOX_NETWORK_ISOLATION=true
SANDBOX_RESTRICTED_ROOT=true

# Provenance & Verification
PROVENANCE_HMAC_SECRET="change-this-provenance-key-in-production"
ALLOWED_PATCH_FILES=["README.md",".devcontainer/devcontainer.json"]
MAX_PATCH_DIFF_LINES=120

